#define g_sw2VendorReply (sw2Session().vendorReply)
#define g_sw2VendorEpOut (sw2Session().vendorEpOut)
#define g_sw2VendorEpIn (sw2Session().vendorEpIn)
#define g_sw2LastReportMs (sw2Session().lastReportMs)
#define g_sw2PairLtk (sw2Session().pairLtk)
#define g_sw2PairLtkValid (sw2Session().pairLtkValid)'''
src = regex_once(src, old_state, new_state, "session state")

src = replace_once(
    src,
    "static volatile bool g_sw2VendorCommandPending = false;\n"
    "static volatile bool g_sw2VendorInFlight = false;\n"
    "static volatile uint8_t g_sw2VendorCommandLen = 0;\n"
